user_cities={}
@bot.message_handler(commands=['new_location'])
def get_new_location(message):
    bot.send_message(message.chat.id, "Please enter city name 🌆:")
    bot.register_next_step_handler(message, set_new_location)

def set_new_location(message):

    city_name = message.text.strip()
    geo_url = f"https://api.openweathermap.org/data/2.5/weather?q={city_name}&appid={API_KEY}"
    geo_resp = requests.get(geo_url)
    geo_data = geo_resp.json()

    if geo_resp.status_code != 200 or geo_data.get("cod") != 200:
        # если город не найден — удаляем старое значение
        if message.chat.id in user_cities:
            del user_cities[message.chat.id]


        bot.send_message(message.chat.id, f"⚠️Oops! *{city_name}* doesn’t ring a bell 🌍 \nPlease check the spelling and try again 🌍",   parse_mode="Markdown")

        # предлагаем ввести заново
        bot.register_next_step_handler(message, set_new_location)
        return

    # если всё ок — сохраняем город
    user_cities[message.chat.id] = city_name
    bot.send_message(
        message.chat.id,
        f"Thank you, location set to *{city_name.title()}*",
        parse_mode="Markdown"
    )

@bot.message_handler(commands=['weather5', 'weather7', 'weather1'])
def handle_forecast(message):
    user_id = message.chat.id
    if user_id not in user_cities:
        bot.send_message(user_id, "⚠️ Please set your location first using /new_location")
        return

    city = user_cities[user_id]

    days=int(message.text[-1])

    forecast_text = get_weather(city, days)
    bot.send_message(user_id, forecast_text, parse_mode="Markdown")





def get_weather(city, days=1):

    geo_url = f"https://api.openweathermap.org/data/2.5/weather?q={city}&appid={API_KEY}"
    geo_resp = requests.get(geo_url)
    geo_data = geo_resp.json()

    if geo_resp.status_code != 200 or "coord" not in geo_data:
        return f"⚠️ Could not get weather for `{city}`. Please check the city name or try again later."

    lat=geo_data['coord']['lat']
    lon=geo_data['coord']['lon']

    if days==1:
        weather_url=f"https://api.openweathermap.org/data/3.0/onecall/overview?lat={lat}&lon={lon}&appid={API_KEY}&units=metric"
    else:
        weather_url=f"https://api.openweathermap.org/data/3.0/onecall?lat={lat}&lon={lon}&appid={API_KEY}&units=metric"
    weather_resp=requests.get(weather_url)
    weather_data = weather_resp.json()

    emoji = {
        "01d": "☀️",  # clear sky (day)
        "01n": "🌙",  # clear sky (night)
        "02d": "🌥",  # few clouds
        "02n": "☁️",
        "03d": "☁️",
        "04d": "☁️",
        "09d": "🌧",
        "10d": "🌦",
        "11d": "🌩",
        "13d": "❄️",
        "50d": "🌫",
    }

    s=f"*{city.title()}* — {days}-day weather forecast:\n\n"
    if days==1:
        return f"☂ Today' weather forecast in *{city.title()}*:\n { weather_data['weather_overview']}"
    else:
        for i in range(min(days, len(weather_data["daily"]))):
            icon=emoji[weather_data["daily"][i]["weather"][0]["icon"]]
            temp_day=weather_data["daily"][i]['temp']['day']
            temp_night = weather_data["daily"][i]['temp']['night']
            curr_weather=weather_data['daily'][i]['weather'][0]['description']
            s+=f"{curr_weather} {icon}: {temp_day:.0f}°C (day) / {temp_night:.0f}°C (night)\n"

        return s


